# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is in .gitignore).
# Every variable is read in ONE place: config/env.js
# ============================================================

# --- Required ---------------------------------------------------
# Neon / PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# At least 64 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- App ----------------------------------------------------------
PORT=5000
NODE_ENV=development
# Public URL of the React app (used in email links + CORS)
CLIENT_URL=http://localhost:5173
# Optional extra front-end origins, comma separated
EXTRA_ALLOWED_ORIGINS=

# Inbox that receives "new request" / "certificate revoked" emails.
# Leave empty to skip admin emails.
ADMIN_EMAIL=

# --- Email (SMTP) -------------------------------------------------
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
SMTP_USER=
# For Gmail use an App Password, not your normal password
SMTP_PASS=
SMTP_FROM="eSparks Certificate Portal <no-reply@example.com>"
